{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bakery-shop",
  "main": "./src/index.js",
  "compatibility_date": "2026-09-05",
  "workers_dev": true,
  "keep_vars": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api", "/api/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
