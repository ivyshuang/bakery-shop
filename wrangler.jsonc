{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bakery-shop",
  "main": "./src/index.js",
  "compatibility_date": "2026-09-05",
  "workers_dev": true,
  "keep_vars": true,
  "ai": { "binding": "AI" },
  "ratelimits": [{ "name": "TRANSLATE_LIMITER", "namespace_id": "91305001", "simple": { "limit": 10, "period": 60 } }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bakery-db",
      "database_id": "126cd2a4-1eb9-40ef-9f21-068447ccac87"
    }
  ],
  "r2_buckets": [{ "binding": "PROCUREMENT_FILES", "bucket_name": "bakery-procurement-files" }],
  
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api", "/api/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
